<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mingler Sync</AssemblyName>
    <RootNamespace>MinglerSync.WinForms</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
    <Version>1.0.3</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <InformationalVersion>1.0.3-rc.2</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('..\..\packaging\Assets\app.ico')">
    <ApplicationIcon>..\..\packaging\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MinglerSync.Core\MinglerSync.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\PLAYER_README.txt" Link="README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\discord-presence.json" Link="discord-presence.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
