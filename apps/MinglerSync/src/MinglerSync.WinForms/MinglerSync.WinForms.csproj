<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mingler Sync</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('..\..\packaging\Assets\app.ico')">
    <ApplicationIcon>..\..\packaging\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\MinglerSync.Core\MinglerSync.Core.csproj" /></ItemGroup>
  <ItemGroup><None Include="..\..\PLAYER_README.txt" Link="README.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>

